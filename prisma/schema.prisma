generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role{
  USER
  ADMIN
}

enum OrderStatus{
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
model User{
  id Int @id @default(autoincrement())
  name String?
  email String @unique
  password String
  role Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  

}

model Cart{
  id Int @id @default(autoincrement())
  userId Int @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
}
model Product{
  id Int @id @default(autoincrement())
}